{
  "name": "kohinoor-hair-salon",
  "version": "1.0.0",
  "description": "Small-business static website for The Kohinoor AC Salon (Kohinoor Hair Salon) at Shivaji Chowk, Pimple Nilakh, Pune.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:cloudflare",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
